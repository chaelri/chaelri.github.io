#!/bin/bash
# Start one of the offline party games and open its board on this Mac.
#   ./play               pick from a menu
#   ./play rambulan      (also: karera, monopoly)
# Ctrl-C (or closing the Terminal window) stops it.
cd "$(dirname "$0")" || exit 1

pick() {
  case "$1" in
    rambulan|arena) DIR=arena;    PORT=8830; NAME=Rambulan ;;
    karera|kart)    DIR=kart;     PORT=8810; NAME=Karera ;;
    monopoly)       DIR=monopoly; PORT=8800; NAME=Monopoly ;;
    *) return 1 ;;
  esac
}

if ! pick "$1"; then
  echo "Which game?"
  PS3="> "
  select g in Rambulan Karera Monopoly; do
    pick "$(echo "$g" | tr '[:upper:]' '[:lower:]')" && break
  done
  [ -z "$NAME" ] && exit 1
fi

# Already up from an earlier run: just show the board again.
if lsof -nP -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1; then
  echo "$NAME is already running."
  open "http://localhost:$PORT/"
  exit 0
fi

exec /usr/bin/python3 -u "$DIR/server.py"
