{
  // Adds "Claude YOLO" to the terminal + dropdown: opens a terminal in this repo
  // already running `claude --dangerously-skip-permissions`.
  // zsh -lic so ~/.zshrc runs and ~/.local/bin (where claude lives) is on PATH.
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "zsh",
      "args": ["-l"]
    },
    "Claude YOLO": {
      "path": "zsh",
      "args": ["-lic", "claude --dangerously-skip-permissions"],
      "icon": "zap",
      "color": "terminal.ansiMagenta"
    }
  },
  "terminal.integrated.defaultProfile.osx": "zsh",

  // The Python extension "activates" a venv by TYPING `source .../activate` into
  // a new terminal. When that terminal is already running `claude`, the text
  // lands in Claude's prompt box instead of a shell. It was also pointing at
  // inlove/.venv, a venv that no longer exists in this repo.
  "python.terminal.activateEnvironment": false,
  "python.terminal.activateEnvInCurrentTerminal": false
}
