{
  "manifest_version": 3,
  "name": "AnimeDownloader",
  "version": "1.2.0",
  "description": "One-click anime bulk downloader via AnimePahe. Discover on LiveChart, download everything automatically.",
  "permissions": ["tabs", "storage", "downloads", "tabGroups", "contextMenus", "declarativeNetRequest", "webNavigation"],
  "host_permissions": [
    "*://*.livechart.me/*",
    "*://*.animepahe.pw/*",
    "*://*.animepahe.com/*",
    "*://*.animepahe.ru/*",
    "*://*.animepahe.org/*",
    "*://kwik.cx/*",
    "*://pahe.win/*",
    "*://gogoanimes.dk/*",
    "*://*.gogoanimes.dk/*",
    "*://vidmoly.org/*",
    "*://vidmoly.to/*",
    "*://vidmoly.me/*",
    "*://vidmoly.net/*",
    "*://vidmoly.biz/*",
    "*://dramavideo.se/*",
    "*://*.dramavideo.se/*",
    "*://animeheaven.me/*",
    "*://*.animeheaven.me/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AnimeDownloader"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.animepahe.pw/play/*",
        "*://*.animepahe.com/play/*",
        "*://*.animepahe.ru/play/*",
        "*://*.animepahe.org/play/*",
        "*://kwik.cx/*",
        "*://pahe.win/*"
      ],
      "js": ["content/guard.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://gogoanimes.dk/*",
        "*://*.gogoanimes.dk/*",
        "*://vidmoly.org/*",
        "*://vidmoly.to/*",
        "*://vidmoly.me/*",
        "*://vidmoly.net/*",
        "*://vidmoly.biz/*"
      ],
      "css": ["content/ad-slots.css"],
      "js": ["content/guard.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://gogoanimes.dk/*", "*://*.gogoanimes.dk/*"],
      "css": ["content/gogoanimes.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://gogoanimes.dk/*", "*://*.gogoanimes.dk/*"],
      "js": ["content/gogoanimes.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://dramavideo.se/*"],
      "js": ["content/dramavideo.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://animeheaven.me/*", "*://*.animeheaven.me/*"],
      "css": ["content/ad-slots.css", "content/animeheaven.css"],
      "js": ["content/guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://animeheaven.me/*", "*://*.animeheaven.me/*"],
      "js": ["content/animeheaven.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.livechart.me/*"],
      "js": ["content/livechart.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.animepahe.pw/*",
        "*://*.animepahe.com/*",
        "*://*.animepahe.ru/*",
        "*://*.animepahe.org/*"
      ],
      "js": ["content/animepahe.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://kwik.cx/*"],
      "js": ["content/kwik.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://kwik.cx/e/*"],
      "js": ["content/kwik-embed.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["*://pahe.win/*"],
      "js": ["content/pahe.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "gogoanimes", "enabled": true, "path": "rules/gogoanimes.json" }
    ]
  }
}
