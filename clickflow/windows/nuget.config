<?xml version="1.0" encoding="utf-8"?>
<!-- The only package the build needs is Microsoft.Windows.SDK.NET.Ref (the Windows OCR
     projections), pulled in by the net8.0-windows10.0.19041.0 target. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
